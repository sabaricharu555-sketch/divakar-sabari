syntax = "proto3";

package canteen.v1;

option go_package = "canteen/v1;canteen_v1";

service CanteenService {
  rpc GetMenu (GetMenuRequest) returns (GetMenuResponse);
  rpc PlaceOrder (PlaceOrderRequest) returns (Order);
  rpc StreamKitchenOrders (StreamOrdersRequest) returns (stream Order);
}

enum OrderStatus {
  ORDER_STATUS_UNSPECIFIED = 0;
  ORDER_STATUS_RECEIVED = 1;
  ORDER_STATUS_PREPARING = 2;
  ORDER_STATUS_READY = 3;
  ORDER_STATUS_COMPLETED = 4;
}

message MenuItem {
  string id = 1;
  string name = 2;
  double price = 3;
  int32 calories = 4;
  repeated string allergens = 5;
}

message GetMenuRequest {
  string campus_id = 1;
  repeated string exclude_allergens = 2;
}

message GetMenuResponse {
  repeated MenuItem items = 1;
}

message OrderItem {
  string item_id = 1;
  int32 quantity = 2;
}

message PlaceOrderRequest {
  string google_user_id = 1;
  string campus_id = 2;
  repeated OrderItem items = 3;
}

message Order {
  string order_id = 1;
  string google_user_id = 2;
  OrderStatus status = 3;
  double total_cost = 4;
  int64 created_at_unix = 5;
}
