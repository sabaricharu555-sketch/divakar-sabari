import express, { Request, Response } from 'express';

const app = express();
app.use(express.json());

interface MenuItem {
  id: number;
  name: string;
  price: number;
  available: boolean;
}

const menu: MenuItem[] = [
  { id: 1, name: 'Veggie Sandwich', price: 4.99, available: true },
  { id: 2, name: 'Cold Brew Coffee', price: 3.50, available: true }
];

// Fetch Menu
app.get('/api/menu', (req: Request, res: Response) => {
  res.json(menu);
});

// Create Order
app.post('/api/orders', (req: Request, res: Response) => {
  const { items, customerId } = req.body;
  res.status(201).json({
    orderId: `ORD-${Date.now()}`,
    status: 'RECEIVED',
    items,
    timestamp: new Date()
  });
});

app.listen(3000, () => console.log('Smart Canteen API running on port 3000'));
