
version: '3.8'

services:
  backend:
    build: ./backend
    ports:
      - "5000:5000"
    environment:
      - PORT=5000
    volumes:
      - ./backend:/app
      - /app/node_modules

  postgres:
    image: postgres:15
    environment:
      POSTGRES_USER: canteen_user
      POSTGRES_PASSWORD: canteen_password
      POSTGRES_DB: smart_canteen
    ports:
      - "5432:5432"
